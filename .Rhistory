sd_Fy   = sd(Fy_maxFtot, na.rm = TRUE),
.groups = "drop"
)
plot_age_Fy <- ggplot(force_data, aes(x = Age, y = Fy_maxFtot, color = Bird)) +
geom_point(position = position_jitter(width = 1), alpha = 0.3) +   # dots = trials
geom_errorbar(
data = summary_df,
aes(x=Age, ymin = mean_Fy - sd_Fy, ymax = mean_Fy + sd_Fy, color = Bird, alpha = 0.6),
width = 2, size = 0.8,
inherit.aes = FALSE) +
geom_point(
data = summary_df,
aes(y = mean_Fy, x = Age, color = Bird, alpha = 0.9),
size = 2, shape = 18,
inherit.aes = FALSE
) +
geom_line(
data = summary_df,
aes(x = Age, y = mean_Fy, color = Bird, group = Bird, alpha = 0.8),
size = 0.7,
inherit.aes = FALSE) +
geom_ribbon(
data = trend_df,
aes(x = Age, ymin = mean_Fy - sd_Fy, ymax = mean_Fy + sd_Fy),
fill = "grey70", alpha = 0.5,
inherit.aes = FALSE
) +
geom_line(
data = trend_df,
aes(x = Age, y = mean_Fy),
color = "grey50", alpha = 0.8,size = 1.2,
inherit.aes = FALSE) +
scale_x_continuous(breaks = unique(force_data$Age)) +
labs(x = "Age", y = "Fy", title = "") +
#ylim(10, 25)+
guides(alpha = "none")+
theme_minimal() +
theme(legend.position = "none")
plot_age_Fy
