lmer_maxF <- lmer(max_Ftot ~ Age*Sex + Brood + hinge + (1|Bird), data = force_data)
# computing residuals
raw_cond_maxF <- compute_redres(lmer_maxF)
hist(raw_cond_maxF) #normality in histogram
plot_redres(lmer_maxF) #heteroskedasticity
plot_resqq(lmer_maxF) #normality of residuals
plot_ranef(lmer_maxF)
## Oops not so well behaving
summary(lmer_maxF)
Anova(lmer_maxF, type =3, test.statistic = "Chisq") # Does age affect bodyweight overall?
linearHypothesis(lmer_maxF, "Age = 0") # Is the slope before the breakpoint flat? -> no
linearHypothesis(lmer_maxF, "Age+hinge = 0") # Is the slope after the breakpoint flat? -> no
